#: accounts/templates/accounts/lawyer_home.html:17
#: cases/templates/cases/default_margin.html:4
#: cases/templates/cases/default_margin.html:7
msgid "Default margin"
msgstr "Marge par défaut"

#: accounts/templates/accounts/lawyer_home.html:18
#: cases/templates/cases/clip.html:23 keys/templates/keys/key.html:4
#: keys/templates/keys/key.html:15

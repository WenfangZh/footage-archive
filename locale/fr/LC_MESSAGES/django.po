msgstr "Vous n'avez pas encore de dossier de recherche."

#: accounts/templates/accounts/lawyer_home.html:15
#: cases/templates/cases/new_case.html:4 cases/templates/cases/new_case.html:15
msgid "New case"
msgstr "Nouveau dossier de recherche"

#: accounts/templates/accounts/lawyer_home.html:16
#: cases/templates/cases/closed_cases.html:4
#: cases/templates/cases/closed_cases.html:7
msgid "Closed cases"

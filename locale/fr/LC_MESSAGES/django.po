#: accounts/templates/accounts/manage_home.html:7
#: alerts/templates/alerts/raise_limit.html:18
#: cases/templates/cases/case_requests.html:17
msgid "Administration"
msgstr "Administration"

#: accounts/templates/accounts/manage_home.html:9

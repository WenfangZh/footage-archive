#: cases/templates/cases/case_requests.html:4
#: cases/templates/cases/case_requests.html:7
msgid "Requests for larger cases"
msgstr "Demandes de dépassement des plafonds"

#: accounts/templates/accounts/manage_home.html:25
msgid "Applicants"
msgstr "Candidat·es"

#: accounts/templates/accounts/manage_home.html:34
msgid "Send a new invitation link"
msgstr "Envoyer un nouveau lien d'invitation"

#: accounts/templates/accounts/manage_home.html:41
msgid "No applicants."
msgstr "Aucun·e candidat·e."

#: accounts/templates/accounts/manage_home.html:44
msgid "Lawyers' access"
msgstr "Accès des avocat·es"

#: accounts/templates/accounts/manage_home.html:54
msgid "Suspend access"
msgstr "Suspendre l'accès"

#: accounts/templates/accounts/manage_home.html:59
msgid "Reinstate access"
msgstr "Rétablir l'accès"

#: accounts/templates/accounts/manage_home.html:62
#: accounts/templates/accounts/revoke.html:4
#: accounts/templates/accounts/revoke.html:7
msgid "Revoke access"
msgstr "Révoquer l'accès"

#: accounts/templates/accounts/manage_home.html:63
#: alerts/templates/alerts/raise_limit.html:4
#: alerts/templates/alerts/raise_limit.html:7
msgid "Raise an alert limit"
msgstr "Relever un seuil d'alerte"

#: accounts/templates/accounts/manage_home.html:68
msgid "No lawyers yet."
msgstr "Aucun·e avocat·e pour l'instant."

#: accounts/templates/accounts/no_access.html:4
#: accounts/templates/accounts/no_access.html:8
msgid "No access"
msgstr "Accès refusé"

#: accounts/templates/accounts/no_access.html:9
msgid "Your account does not give access to this page."
msgstr "Votre compte ne donne pas accès à cette page."

#: accounts/templates/accounts/recovery_codes.html:4
#: accounts/templates/accounts/recovery_codes.html:7
msgid "Your recovery codes"
msgstr "Vos codes de secours"

#: accounts/templates/accounts/recovery_codes.html:8
msgid ""
"Keep these codes somewhere safe, away from your phone. Each one lets you log "
"in once if you lose the phone. They are shown only now."
msgstr ""
"Gardez ces codes en lieu sûr, loin de votre téléphone. Chacun permet de vous "
"connecter une fois si vous perdez le téléphone. Ils ne sont affichés que "
"maintenant."

#: accounts/templates/accounts/recovery_codes.html:12
msgid "I have saved them: continue"
msgstr "Je les ai enregistrés : continuer"

#: accounts/templates/accounts/revoke.html:9
#, python-format
msgid ""
"%(name)s will lose access for good, and their %(cases)s open case will be "
"closed."
msgid_plural ""
"%(name)s will lose access for good, and their %(cases)s open cases will be "
"closed."
msgstr[0] ""
"%(name)s perdra son accès définitivement, et son dossier de recherche ouvert "
"sera clos."
msgstr[1] ""
"%(name)s perdra son accès définitivement, et ses %(cases)s dossiers de "
"recherche ouverts seront clos."

#: accounts/templates/accounts/revoke.html:11
#, python-format
msgid "%(name)s will lose access for good. They have no open cases."
msgstr ""
"%(name)s perdra son accès définitivement. Cette personne n'a aucun dossier "
"de recherche ouvert."

#: accounts/templates/accounts/revoke.html:13
msgid ""
"This can never be undone. Nothing they did is deleted. To suspend their "
"access for a while instead, use suspension."
msgstr ""
"C'est définitif. Rien de ce que la personne a fait n'est effacé. Pour "
"suspendre son accès pour un temps, utilisez plutôt la suspension de l'accès."

#: accounts/templates/accounts/revoke.html:16
msgid "The address typed does not match."
msgstr "L'adresse saisie ne correspond pas."

#: accounts/templates/accounts/revoke.html:17
#, python-format
msgid "To confirm, type their email address (%(email)s):"
msgstr "Pour confirmer, saisissez son adresse e-mail (%(email)s) :"

#: accounts/templates/accounts/revoke.html:19
msgid "Revoke access for good"
msgstr "Révoquer l'accès définitivement"

#: accounts/templates/accounts/two_factor_setup.html:4
#: accounts/templates/accounts/two_factor_setup.html:7
msgid "Set up two-factor authentication"
msgstr "Activer la double authentification"

#: accounts/templates/accounts/two_factor_setup.html:8
msgid ""
"Every login needs a code from an authenticator app on your phone, as well as "
"your password."
msgstr ""
"Chaque connexion demande, en plus de votre mot de passe, un code d'une "
"application d'authentification sur votre téléphone."

#: accounts/templates/accounts/two_factor_setup.html:9
msgid ""
"Scan this QR code with the app, or type in the key below, then enter the six-"
"digit code the app shows."
msgstr ""
"Scannez ce QR code avec l'application, ou saisissez la clé ci-dessous, puis "
"entrez le code à six chiffres qu'elle affiche."

#: accounts/templates/accounts/two_factor_setup.html:11
msgid "Key:"
msgstr "Clé :"

#: accounts/templates/accounts/two_factor_setup.html:16
#: accounts/templates/accounts/two_factor_verify.html:13
msgid "Confirm"
msgstr "Confirmer"

#: accounts/templates/accounts/two_factor_verify.html:4
#: accounts/templates/accounts/two_factor_verify.html:7
msgid "Two-factor authentication"
msgstr "Double authentification"

#: accounts/templates/accounts/two_factor_verify.html:8
msgid ""
"Enter the six-digit code from your authenticator app, or one of your "
"recovery codes."
msgstr ""
"Saisissez le code à six chiffres de votre application d'authentification, ou "
"l'un de vos codes de secours."

#: accounts/two_factor.py:40
msgid ""
"This six-digit code is not right. Check the time on your phone and try again."
msgstr ""
"Ce code à six chiffres n'est pas valide. Vérifiez l'heure de votre téléphone "
"et réessayez."

#: accounts/two_factor.py:41
msgid "This recovery code is not right, or has been used already."
msgstr "Ce code de secours n'est pas valide, ou a déjà servi."

#: accounts/two_factor.py:42
msgid "Too many wrong codes. Wait a few minutes before trying again."
msgstr "Trop de codes erronés. Attendez quelques minutes avant de réessayer."

#: accounts/two_factor.py:47
msgid "Six-digit code from the app, or recovery code"
msgstr "Code à six chiffres de l'application, ou code de secours"

#: accounts/views.py:25
msgid ""
"Please enter a correct email address and password. The password is case-"
"sensitive."
msgstr ""
"Saisissez une adresse e-mail et un mot de passe valides. Le mot de passe "
"tient compte des majuscules et des minuscules."

#: alerts/models.py:19
msgid "The ingest queue is backed up"
msgstr "La file de préparation est engorgée"

#: alerts/models.py:20
msgid "Many failed logins for one account"
msgstr "Nombreuses connexions échouées pour un même compte"

#: alerts/models.py:21
msgid "Many downloads by one lawyer in a short time"
msgstr "Beaucoup de téléchargements par un·e avocat·e en peu de temps"

#: alerts/models.py:22
msgid "Many cases created by one lawyer in a short time"
msgstr ""
"Beaucoup de dossiers de recherche créés par un·e avocat·e en peu de temps"

#: alerts/models.py:23
msgid "A key grant did not open for the lawyer who received it"
msgstr ""
"Une remise de la clé commune ne s'est pas ouverte pour l'avocat·e qui l'a "
"reçue"

#: alerts/models.py:41
msgid "Downloads"
msgstr "Téléchargements"

#: alerts/models.py:42
msgid "Cases created"
msgstr "Dossiers de recherche créés"

#: alerts/templates/alerts/raise_limit.html:8
#, python-format
msgid ""
"For %(name)s, for a few days, such as while they work on a large case. "
"Usually you are alerted at %(downloads)s downloads or %(cases)s cases "
"created in a short time. The raise is recorded in the audit log."
msgstr ""
"Pour %(name)s, pendant quelques jours, par exemple pendant un dossier "
"important. D'habitude, vous êtes alerté·e à %(downloads)s téléchargements ou "
"%(cases)s dossiers de recherche créés en peu de temps. Le relèvement est "
"inscrit au journal d'audit."

#: alerts/templates/alerts/raise_limit.html:10
msgid "Raises in force"
msgstr "Relèvements en cours"

#: alerts/templates/alerts/raise_limit.html:11
#, python-format
msgid "%(activity)s: %(limit)s, until %(until)s"
msgstr "%(activity)s : %(limit)s, jusqu'au %(until)s"

#: alerts/templates/alerts/raise_limit.html:16
msgid "Raise the limit"
msgstr "Relever le seuil d'alerte"

#: alerts/views.py:31
msgid "Alert"
msgstr "Alerte"

#: alerts/views.py:32
msgid "New limit"
msgstr "Nouveau seuil d'alerte"

#: alerts/views.py:33
msgid "For how many days"
msgstr "Pendant combien de jours"

#: alerts/views.py:40
#, python-format
msgid "At most %(days)s."
msgstr "Au plus %(days)s."

#: alerts/views.py:49
#, python-format
msgid "A raise must be higher than the limit now: %(limit)s."
msgstr ""
"Le nouveau seuil d'alerte doit dépasser le seuil d'alerte actuel : %(limit)s."

#: alerts/views.py:51
#, python-format
msgid "At most ten times the usual limit: %(limit)s."
msgstr "Au plus dix fois le seuil d'alerte habituel : %(limit)s."

#: alerts/views.py:78
msgid "The alert limit is raised."
msgstr "Le seuil d'alerte est relevé."


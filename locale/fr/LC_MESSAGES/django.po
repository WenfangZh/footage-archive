#: accounts/models.py:71
msgid "email address"
msgstr "adresse e-mail"

#: accounts/models.py:123
msgid "Applicant"
msgstr "Candidat·e"

#: accounts/models.py:124
msgid "Declined applicant"
msgstr "Candidat·e non retenu·e"

#: accounts/models.py:126
msgid "Lawyer"
msgstr "Avocat·e"

#: accounts/models.py:127
msgid "Suspended lawyer"
msgstr "Avocat·e à l'accès suspendu"

#: accounts/models.py:128
msgid "Revoked lawyer"
msgstr "Avocat·e à l'accès révoqué"

#: accounts/templates/accounts/applicant.html:4
#: accounts/templates/accounts/applicant.html:7
msgid "Waiting for admission"
msgstr "En attente d'admission"

#: accounts/templates/accounts/applicant.html:8
msgid ""
"Your account is ready, but the admin has not admitted you yet. Until then, "
"the archive shows you nothing."
msgstr ""
"Votre compte est prêt, mais l'administrateur·rice ne vous a pas encore "
"admis·e. D'ici là, l'archive ne vous montre rien."

#: accounts/templates/accounts/lawyer_home.html:4
#: accounts/templates/accounts/lawyer_home.html:7
msgid "Your cases"
msgstr "Vos dossiers de recherche"

#: accounts/templates/accounts/lawyer_home.html:8
msgid "You have no cases yet."
msgstr "Vous n'avez pas encore de dossier de recherche."

#: accounts/templates/accounts/login.html:4
#: accounts/templates/accounts/login.html:7
#: accounts/templates/accounts/login.html:13
msgid "Log in"
msgstr "Se connecter"

#: accounts/templates/accounts/login.html:8
msgid "For defence lawyers and the admin. Uploading a video needs no account."
msgstr ""
"Pour les avocat·es de la défense et l'administrateur·rice. Envoyer une vidéo "
"ne demande pas de compte."

#: accounts/templates/accounts/login_limited.html:4
#: accounts/templates/accounts/login_limited.html:8
#: clips/templates/clips/rate_limited.html:4
#: clips/templates/clips/rate_limited.html:8
msgid "Too many attempts"
msgstr "Trop de tentatives"

#: accounts/templates/accounts/login_limited.html:9
msgid "There have been too many attempts to log in. Try again in an hour."
msgstr "Il y a eu trop de tentatives de connexion. Réessayez dans une heure."

#: accounts/templates/accounts/manage_home.html:4
#: accounts/templates/accounts/manage_home.html:7
msgid "Administration"
msgstr "Administration"

#: accounts/templates/accounts/no_access.html:4
#: accounts/templates/accounts/no_access.html:8
msgid "No access"
msgstr "Accès refusé"

#: accounts/templates/accounts/no_access.html:9
msgid "Your account does not give access to this page."
msgstr "Votre compte ne donne pas accès à cette page."

#: accounts/templates/accounts/recovery_codes.html:4
#: accounts/templates/accounts/recovery_codes.html:7
msgid "Your recovery codes"
msgstr "Vos codes de secours"

#: accounts/templates/accounts/recovery_codes.html:8
msgid ""
"Keep these codes somewhere safe, away from your phone. Each one lets you log "
"in once if you lose the phone. They are shown only now."
msgstr ""
"Gardez ces codes en lieu sûr, loin de votre téléphone. Chacun permet de vous "
"connecter une fois si vous perdez le téléphone. Ils ne sont affichés que "
"maintenant."

#: accounts/templates/accounts/recovery_codes.html:12
msgid "I have saved them: continue"
msgstr "Je les ai enregistrés : continuer"

#: accounts/templates/accounts/two_factor_setup.html:4
#: accounts/templates/accounts/two_factor_setup.html:7
msgid "Set up two-factor authentication"
msgstr "Activer la double authentification"

#: accounts/templates/accounts/two_factor_setup.html:8
msgid ""
"Every login needs a code from an authenticator app on your phone, as well as "
"your password."
msgstr ""
"Chaque connexion demande, en plus de votre mot de passe, un code d'une "
"application d'authentification sur votre téléphone."

#: accounts/templates/accounts/two_factor_setup.html:9
msgid ""
"Scan this QR code with the app, or type in the key below, then enter the six-"
"digit code the app shows."
msgstr ""
"Scannez ce QR code avec l'application, ou saisissez la clé ci-dessous, puis "
"entrez le code à six chiffres qu'elle affiche."

#: accounts/templates/accounts/two_factor_setup.html:11
msgid "Key:"
msgstr "Clé :"

#: accounts/templates/accounts/two_factor_setup.html:16
#: accounts/templates/accounts/two_factor_verify.html:13
msgid "Confirm"
msgstr "Confirmer"

#: accounts/templates/accounts/two_factor_verify.html:4
#: accounts/templates/accounts/two_factor_verify.html:7
msgid "Two-factor authentication"
msgstr "Double authentification"

#: accounts/templates/accounts/two_factor_verify.html:8
msgid ""
"Enter the six-digit code from your authenticator app, or one of your "
"recovery codes."
msgstr ""
"Saisissez le code à six chiffres de votre application d'authentification, ou "
"l'un de vos codes de secours."

#: accounts/two_factor.py:38
msgid ""
"This six-digit code is not right. Check the time on your phone and try again."
msgstr "Ce code à six chiffres n'est pas valide. Vérifiez l'heure de votre téléphone et réessayez."

#: accounts/two_factor.py:39
msgid "This recovery code is not right, or has been used already."
msgstr "Ce code de secours n'est pas valide, ou a déjà servi."

#: accounts/two_factor.py:40
msgid "Too many wrong codes. Wait a few minutes before trying again."
msgstr "Trop de codes erronés. Attendez quelques minutes avant de réessayer."

#: accounts/two_factor.py:45
msgid "Six-digit code from the app, or recovery code"
msgstr "Code à six chiffres de l'application, ou code de secours"

#: accounts/views.py:21
msgid ""
"Please enter a correct email address and password. The password is case-"
"sensitive."
msgstr ""
"Saisissez une adresse e-mail et un mot de passe valides. Le mot de passe "
"tient compte des majuscules et des minuscules."

#: audit/models.py:23
msgid "Invitation"
msgstr "Invitation"

#: audit/models.py:24
msgid "Declining"
msgstr "Candidature non retenue"

#: audit/models.py:25
msgid "Admission"
msgstr "Admission"

#: audit/models.py:26
msgid "Suspension"
msgstr "Suspension de l'accès"

#: audit/models.py:27
msgid "Reinstatement"
msgstr "Rétablissement de l'accès"

#: audit/models.py:28
msgid "Revocation"
msgstr "Révocation de l'accès"

#: clips/forms.py:14
msgid "About 50 m"
msgstr "Environ 50 m"

#: clips/forms.py:15
msgid "About 130 m"
msgstr "Environ 130 m"

#: clips/forms.py:16
msgid "About 340 m"
msgstr "Environ 340 m"

#: clips/forms.py:24
msgid "Video"
msgstr "Vidéo"

#: clips/forms.py:45
msgid "When was it filmed?"
msgstr "Quand la vidéo a-t-elle été filmée ?"

#: clips/forms.py:49
msgid "Latitude"
msgstr "Latitude"

#: clips/forms.py:53
msgid "Longitude"
msgstr "Longitude"

#: clips/forms.py:57
msgid "How precise is this place?"
msgstr "Quelle est la précision de ce lieu ?"

#: clips/forms.py:61
msgid "What can be seen?"
msgstr "Que voit-on dans la vidéo ?"

#: clips/forms.py:65
msgid "Other tags, separated by commas"
msgstr "Autres étiquettes, séparées par des virgules"

#: clips/forms.py:69 clips/models.py:183 clips/models.py:228
msgid "Context"
msgstr "Contexte"

#: clips/forms.py:71
msgid ""
"What happened, and anything a lawyer should know. Leave out names, and "
"addresses more precise than the place above."
msgstr ""
"Ce qui s'est passé, et tout ce qu'un·e avocat·e devrait savoir. N'indiquez "
"pas de noms, ni d'adresse plus précise que le lieu ci-dessus."

#: clips/forms.py:76
msgid "Contact details or social media handle"
msgstr "Moyen de contact ou pseudonyme sur un réseau social"

#: clips/forms.py:88
#, python-format
msgid "Each tag can be at most %(length)d characters."
msgstr "Chaque étiquette peut compter au plus %(length)d caractères."

#: clips/forms.py:94
#, python-format
msgid "At most %(count)d other tags."
msgstr "Au plus %(count)d autres étiquettes."

#: clips/forms.py:104
msgid "Give both the latitude and the longitude, or neither."
msgstr "Indiquez la latitude et la longitude, ou aucune des deux."

#: clips/forms.py:106
msgid "Say how precise this place is."
msgstr "Indiquez la précision de ce lieu."

#: clips/forms.py:114
msgid "How precisely may we keep the GPS position found in the video?"
msgstr ""
"Avec quelle précision pouvons-nous garder la position GPS trouvée dans la "
"vidéo ?"

#: clips/forms.py:129
msgid "How precisely we keep the GPS position found in the video"
msgstr ""
"Précision avec laquelle nous gardons la position GPS trouvée dans la vidéo"

#: clips/forms.py:157
msgid "To make the place more precise, give its new position."
msgstr "Pour rendre le lieu plus précis, indiquez sa nouvelle position."


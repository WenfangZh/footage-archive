msgid "Footage archive"
msgstr "Archive de vidéos"

#: templates/base.html:29
msgid "Log out"
msgstr "Se déconnecter"

#: templates/home.html:6
msgid "Learning build: not deployed, not for real footage."
msgstr ""
"Version d'apprentissage : non déployée, à ne pas utiliser pour de vraies "
"vidéos."

#: templates/home.html:9
msgid "Defence lawyers: log in"
msgstr "Avocat·es de la défense : se connecter"


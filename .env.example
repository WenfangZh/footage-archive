# Copy to .env and fill in. Never commit .env.

# Required. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# true for local development only.
DJANGO_DEBUG=true

# Comma-separated host names; can stay empty while DJANGO_DEBUG is true.
DJANGO_ALLOWED_HOSTS=

# Where the SQLite database, the quarantine and the vault live; defaults to ./var
DJANGO_DATA_DIR=

# Required. Key for the keyed hash of upload codes, at least 32 characters.
# Generate it with the same command as DJANGO_SECRET_KEY; the two must differ.
UPLOAD_CODE_KEY=

# Largest accepted file in bytes; defaults to 2000000000 (2 GB).
UPLOAD_MAX_BYTES=

# Minutes before an original whose form was never confirmed is deleted; defaults to 120.
UNCONFIRMED_ORIGINAL_MINUTES=

# Time limit for one ingest attempt, in minutes; defaults to 10.
INGEST_ATTEMPT_MINUTES=

# The ingest queue alerts the admin when more than QUEUE_ALERT_CLIPS clips wait (default
# 20), or one still waits QUEUE_ALERT_HOURS after its upload's 4-hour block (default 2).
QUEUE_ALERT_CLIPS=
QUEUE_ALERT_HOURS=

# H3 resolution of the location grid (ADR 0003); defaults to 11, cells about 50 m
# across. Lower numbers are coarser; finer than 11 is refused.
GRID_H3_RESOLUTION=

# A case's size caps, margin included (SPEC.md §7): its time window in minutes (default
# 120) and its area's width in metres (default 2000). A larger case needs the admin's
# approval. They can only be lowered: the code's ceilings (1440 minutes, 10000 metres) stop
# startup if exceeded.
CASE_WINDOW_CAP_MINUTES=
CASE_AREA_CAP_METRES=

# Days without a search, preview or download after which a case closes on its own
# (default 365).
CASE_INACTIVITY_DAYS=

# Rotations of the group key: days a lawyer drawn for a role has before it is given up or
# drawn again (default 3); days since a lawyer last unlocked their key for them to be drawn
# (default 7); days a rotation waits for enough lawyers before the admin is alerted (default 7).
ROTATION_ROLE_DAYS=
ROTATION_UNLOCK_DAYS=
ROTATION_START_ALERT_DAYS=

# Lawyers see a stated time highlighted when it differs from the metadata time by more
# than this many minutes (default 15).
TIME_MISMATCH_MINUTES=

# Rate limits per connection, per window of RATE_LIMIT_WINDOW_MINUTES (default 60):
# upload attempts (default 20) and wrong upload codes (default 20).
RATE_LIMIT_WINDOW_MINUTES=
RATE_LIMIT_UPLOADS=
RATE_LIMIT_FAILED_CODES=
# Failed logins per window: per connection (default 20), and per account on one connection
# (default 10).
RATE_LIMIT_FAILED_LOGINS=
RATE_LIMIT_FAILED_LOGINS_FOR_ACCOUNT=
# Failed logins for one account from anywhere, per window, that alert the admin (default 30).
ALERT_FAILED_LOGINS=

# Unusual lawyer activity that alerts the admin: ALERT_DOWNLOADS downloads by one lawyer
# within ALERT_DOWNLOADS_MINUTES (defaults 20 and 60), or ALERT_CASES cases created within
# ALERT_CASES_HOURS (defaults 5 and 24). The admin can raise one lawyer's limit for at
# most ALERT_RAISE_MAX_DAYS days (default 3).
ALERT_DOWNLOADS=
ALERT_DOWNLOADS_MINUTES=
ALERT_CASES=
ALERT_CASES_HOURS=
ALERT_RAISE_MAX_DAYS=

# Hours a login lasts at most; defaults to 24.
SESSION_HOURS=

# Days an invitation link works; defaults to 3.
INVITATION_DAYS=

# Email: empty prints each email in the terminal instead of sending it, which is allowed
# only while DJANGO_DEBUG is true. Seconds to wait for the mail server: default 10.
EMAIL_BACKEND=
EMAIL_TIMEOUT=
DEFAULT_FROM_EMAIL=

# Copy to .env and fill in. Never commit .env.

# Required. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# true for local development only.
DJANGO_DEBUG=true

# Comma-separated host names; can stay empty while DJANGO_DEBUG is true.
DJANGO_ALLOWED_HOSTS=

# Where the SQLite database, the quarantine and the vault live; defaults to ./var
DJANGO_DATA_DIR=

# Required. Key for the keyed hash of upload codes, at least 32 characters.
# Generate it with the same command as DJANGO_SECRET_KEY; the two must differ.
UPLOAD_CODE_KEY=

# Largest accepted file in bytes; defaults to 2000000000 (2 GB).
UPLOAD_MAX_BYTES=

# Minutes before an original whose form was never confirmed is deleted; defaults to 120.
UNCONFIRMED_ORIGINAL_MINUTES=

# Time limit for one ingest attempt, in minutes; defaults to 10.
INGEST_ATTEMPT_MINUTES=

# H3 resolution of the location grid (ADR 0003); defaults to 11, cells about 50 m
# across. Lower numbers are coarser; finer than 11 is refused.
GRID_H3_RESOLUTION=

# Rate limits per connection, per window of RATE_LIMIT_WINDOW_MINUTES (default 60):
# upload attempts (default 20) and wrong upload codes (default 20).
RATE_LIMIT_WINDOW_MINUTES=
RATE_LIMIT_UPLOADS=
RATE_LIMIT_FAILED_CODES=
# Failed logins per window: per connection (default 20), and per account on one connection
# (default 10).
RATE_LIMIT_FAILED_LOGINS=
RATE_LIMIT_FAILED_LOGINS_FOR_ACCOUNT=

# Hours a login lasts at most; defaults to 24.
SESSION_HOURS=

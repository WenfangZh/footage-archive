# Copy to .env and fill in. Never commit .env.

# Required. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# true for local development only.
DJANGO_DEBUG=true

# Comma-separated host names; can stay empty while DJANGO_DEBUG is true.
DJANGO_ALLOWED_HOSTS=

# Where the SQLite database and stored media live; defaults to ./var
DJANGO_DATA_DIR=
